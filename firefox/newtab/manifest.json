{
  "manifest_version": 2,
  "name": "Linden Start",
  "version": "0.2.0",
  "description": "A warm, restrained start page for Linden.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "https://feeds.bbci.co.uk/*",
    "history",
    "search"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "linden-start@linden.browser"
    }
  }
}