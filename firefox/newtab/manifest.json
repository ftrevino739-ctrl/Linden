{
  "manifest_version": 2,
  "name": "Linden Start",
  "version": "0.3.0",
  "description": "Página de inicio y búsqueda propia de Linden, con fuentes independientes.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "https://feeds.bbci.co.uk/*",
    "http://127.0.0.1:8787/*",
    "history"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "linden-start@linden.browser"
    }
  }
}
